# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
backend.hcl
!backend.hcl.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.terraform.lock.hcl

# AWS / creds
.aws/
*.pem

# Python (eval framework / BYO agents)
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example

# Personal command cheatsheet (not for the repo)
COMMANDS.md

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local eval tooling (npm install --no-save promptfoo)
node_modules/

# Product-page drafts — kept private/local, EXCEPT the published pages below, which are
# served publicly via GitHub Pages (see .github/workflows/pages.yml) and linked from the
# portfolio site. Anything else here (product-notes.html, site/README.md) stays local.
# NOTE: `site/*` also ignores the diagrams DIRECTORY, so it must be un-ignored before the
# files inside it can be — hence the two diagram lines, not one.
site/*
!site/index.html
!site/fleet.html
!site/evidence.html
!site/architecture.html
!site/styles.css
!site/diagrams/
!site/diagrams/*.svg
